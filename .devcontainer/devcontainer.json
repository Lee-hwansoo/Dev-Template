// =============================================================================
// Run `make setup` or `make ide-config` to generate the compose configuration
// and update service/remoteUser for this host.
// =============================================================================
{
    "name": "DevKit Workspace",

    // Generated by `make ide-config`: the fully resolved compose file, so the
    // IDE attaches with exactly the mounts and environment `make start` uses.
    "dockerComposeFile": [
        "../.docker_cache/ide.compose.json"
    ],
    // Resolved from ENV and the host GPU profile by `make ide-config`.
    "service": "ros-cpu",
    "workspaceFolder": "${containerEnv:WORKSPACE_PATH:/workspace}",
    "shutdownAction": "none",

    // Reuse the ROS/venv environment loaded by config/init_bash.sh.
    "userEnvProbe": "loginInteractiveShell",

    // In-Container Extensions
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "streetsidesoftware.code-spell-checker",
        "ms-python.python",
                "ms-python.debugpy",
                "charliermarsh.ruff",
                "ms-iot.vscode-ros",
                "redhat.vscode-xml",
                "redhat.vscode-yaml",
                "EditorConfig.EditorConfig"
            ]
            // No "settings" block: .vscode/settings.json already carries these
            // (interpreter, compileCommands, shell) as ${workspaceFolder} paths,
            // which resolve in the container and on the host alike — and
            // workspace settings win over the ones injected from here, so a copy
            // would only ever be the stale half. check [vscode-json] forbids it.
        }
    },

    "remoteUser": "user"
}
