// =============================================================================
// .devcontainer/devcontainer.json
// Cross-Platform VSCode Dev Containers Configuration for DevKit
//
// Supports Native Linux, Windows WSL2, and macOS (Apple Silicon / Intel)
// Works with ROS 2 (Humble), ROS 1 (Noetic), Pure C++, and Pure Python.
// =============================================================================
{
    "name": "DevKit Workspace",

    // Attach seamlessly to the compose service managed by `make start`
    "dockerComposeFile": [
        "../docker-compose.dev.yml"
    ],
    "service": "ros-cpu",
    "workspaceFolder": "${containerEnv:WORKSPACE_PATH:/workspace}",
    "shutdownAction": "none",

    // In-Container Extensions
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "ms-python.python",
                "ms-python.debugpy",
                "charliermarsh.ruff",
                "ms-iot.vscode-ros",
                "redhat.vscode-xml",
                "redhat.vscode-yaml",
                "EditorConfig.EditorConfig"
            ],
            "settings": {
                "python.defaultInterpreterPath": "${containerEnv:WORKSPACE_PATH:/workspace}/install/.venv/bin/python",
                "C_Cpp.default.compileCommands": "${containerEnv:WORKSPACE_PATH:/workspace}/build/compile_commands.json",
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },

    // Environment Injections (Ensures C++ IntelliSense and CMake Tools resolve ROS headers)
    "remoteEnv": {
        "ROS_DISTRO": "${containerEnv:ROS_DISTRO:humble}",
        "CMAKE_CXX_STANDARD": "${localEnv:CMAKE_CXX_STANDARD:17}",
        "CMAKE_C_STANDARD": "${localEnv:CMAKE_C_STANDARD:11}",
        "PATH": "${containerEnv:WORKSPACE_PATH:/workspace}/install/.venv/bin:${containerEnv:WORKSPACE_PATH:/workspace}/install/bin:${containerEnv:PATH}",
        "AMENT_PREFIX_PATH": "${containerEnv:WORKSPACE_PATH:/workspace}/install:/opt/ros/${containerEnv:ROS_DISTRO:humble}",
        "CMAKE_PREFIX_PATH": "${containerEnv:WORKSPACE_PATH:/workspace}/install:/opt/ros/${containerEnv:ROS_DISTRO:humble}",
        "LD_LIBRARY_PATH": "${containerEnv:WORKSPACE_PATH:/workspace}/install/lib:/opt/ros/${containerEnv:ROS_DISTRO:humble}/lib:${containerEnv:LD_LIBRARY_PATH}",
        "ROS_PACKAGE_PATH": "${containerEnv:WORKSPACE_PATH:/workspace}/src:/opt/ros/${containerEnv:ROS_DISTRO:humble}/share",
        "PYTHONPATH": "${containerEnv:WORKSPACE_PATH:/workspace}/install/.venv/lib/python${containerEnv:UV_PYTHON:3.10}/site-packages:${containerEnv:WORKSPACE_PATH:/workspace}/install/lib/python3/dist-packages:/opt/ros/${containerEnv:ROS_DISTRO:humble}/lib/python3/dist-packages:${containerEnv:PYTHONPATH}"
    },

    // Post-Attach Lifecycle Hook (Sources init_bash.sh for complete ROS + Python environment)
    // $WORKSPACE_PATH resolves in the container shell, so a relocated workspace keeps working.
    "postAttachCommand": "bash -lc 'source \"$WORKSPACE_PATH/config/init_bash.sh\" 2>/dev/null || true; echo \"🚀 DevKit Container Ready!\"'",

    "remoteUser": "${localEnv:CONTAINER_USER:user}"
}
