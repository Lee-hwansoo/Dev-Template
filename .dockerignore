# =============================================================================
# .dockerignore — what never enters the build context. The prod builders COPY
# src/, dependencies/, config/, scripts/, VERSION and a root CMakeLists.txt +
# cmake/ when present; everything else is noise.
# =============================================================================

# AI / agent state — per-user, and it can hold tokens and session data
.agents/
.codex/
.claude/

# Git
.git/
.gitignore
.gitattributes

# Build Artifacts (devel/ is catkin's; *.oci.tar is the bake's own export)
*.sif
*.oci.tar

# Thirdparty (Cloned inside the container via vcs import)
src/thirdparty/*
!src/thirdparty/.gitkeep

# Python. '**/' on everything that can sit at any depth: a bare pattern is
# matched against the context ROOT only, so src/app/.venv, src/pkg/__pycache__
# and a nested .env all rode into the context (and into the `COPY .` snapshot).
# Build outputs at ANY depth: a nested package's build/ and a stray
# src/.docker_cache rode into the `COPY .` dev snapshot.
**/build/
**/devel/
**/install/
**/log/
**/logs/
**/.docker_cache/
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/
**/env/
**/*.egg-info/
**/.eggs/
**/dist/
.python-version
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.coverage
**/coverage.xml
**/nosetests.xml

# C++ CMake cache
**/CMakeCache.txt
**/CMakeFiles/
**/cmake_install.cmake
_build/

# IDE
.devcontainer/
**/.vscode/
.idea/

# Environment (Security). A nested .env is a fork's own secret store.
**/.env
**/.env.*

# Archives (Exclude by default, whitelist build-time dependencies)
**/*.zip
**/*.tar.gz
!dependencies/*.zip
!dependencies/*.tar.gz

# OS / System Files
**/.DS_Store
**/Thumbs.db

# Temporary & Backup Files
**/*~
**/*.bak
**/*.swp
**/*.swo
**/*.patch
*.tar.xz
*.sif.sha256
*.sif.provenance

# Markdown is NOT excluded: `make bake-dev` copies the whole tree into the
# snapshot image, and a workspace without its README is a worse artifact.
