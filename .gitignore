# =============================================================================
# .gitignore — build output, third-party imports, per-user tooling state.
# .vscode/ is tracked on purpose: it is the shared IDE contract.
# =============================================================================

# --- Build Artifacts ---------------------------------
build/
devel/
install/
log/
logs/

# --- Thirdparty (vcs import) -------------------------
src/thirdparty/*
!src/thirdparty/.gitkeep
!dependencies/overlay/**/COLCON_IGNORE
!dependencies/overlay/**/CATKIN_IGNORE

# --- Python ------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
dist/
.eggs/
.venv
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Per-user agent/editor state
.claude/
.codex/
.agents/

# --- C++ Build ---------------------------------------
*.o
*.a
*.so
*.so.*
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
_build/
colcon.meta
compile_commands.json

# --- Docker / Environment ----------------------------
.env
.env.local
.env.*.local
.docker_cache/
*.oci.tar
*.sif.sha256
*.sif.provenance
*.oci.tar.provenance
*.sif

# --- IDE ---------------------------------------------
.vscode/*.log
.vscode/.debug.env
.vscode/ipch/
.idea/
*.swp
*.swo
*~

# --- OS ----------------------------------------------
.DS_Store
Thumbs.db

# --- Archives ----------------------------------------
*.zip
*.tar.gz
*.tar.xz
.env.tmp
