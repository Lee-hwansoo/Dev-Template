{
    // =========================================================================
    // .vscode/c_cpp_properties.json — IntelliSense profiles. Pick one in the
    // status bar:
    //   "Docker (Container)"  editing inside the container (Dev Containers)
    //   "Host (macOS)"        editing on macOS against the bind mount
    //   "Host (Linux/WSL)"    editing on Linux/WSL against the bind mount
    //
    // Paths are ${workspaceFolder}-relative: ${env:WS_*} resolves to nothing in
    // the IDE process (check [vscode-json]). ${env:ROS_DISTRO} and
    // ${env:CMAKE_*_STANDARD} come from compose, so only the container profile
    // reads them. Host IntelliSense also needs ROS_BUILD_VOL=./build in .env.
    // =========================================================================
    "version": 4,
    "configurations": [
        {
            "name": "Docker (Container)",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c${env:CMAKE_C_STANDARD}",
            "cppStandard": "c++${env:CMAKE_CXX_STANDARD}",
            "includePath": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/install/*/include/**",
                "/opt/ros/${env:ROS_DISTRO}/include/**",
                "/usr/include/**"
            ],
            "defines": [],
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "browse": {
                "path": [
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/install/*/include",
                    "/opt/ros/${env:ROS_DISTRO}/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        },
        {
            "name": "Host (macOS)",
            "intelliSenseMode": "macos-clang-arm64",
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "includePath": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/install/*/include/**"
            ],
            "defines": [],
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        },
        {
            "name": "Host (Linux/WSL)",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "includePath": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/install/*/include/**"
            ],
            "defines": [],
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        }
    ]
}
