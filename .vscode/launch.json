{
    // =========================================================================
    // .vscode/launch.json — C++ via GDB (launch & attach), Python via debugpy
    // (local & remote), ROS 1/2 launch and node debugging, and compounds for
    // multi-process sessions.
    //
    // Environment: every launch reads .vscode/.debug.env (envFile), written by
    // the pre-launch task through `mdebugenv` from the SOURCED workspace — the
    // real overlay (colcon's per-package prefixes, ROS 1's devel/, the venv,
    // the GPU library path), never a static copy. Prerequisites: a Debug build
    // (Ctrl+Shift+B → "🔨 colcon: Build (Debug)" / "🔨 cmake: Build (Debug)"),
    // and debugpy in the container for remote Python.
    // =========================================================================
    "version": "0.2.0",
    "inputs": [
        {
            "id": "executablePath",
            "type": "promptString",
            "description": "Absolute path to executable (e.g., ${workspaceFolder}/install/pkg_name/lib/pkg_name/my_node)",
            "default": "${workspaceFolder}/install/pkg_name/lib/pkg_name/my_node"
        },
        {
            "id": "launchFile",
            "type": "promptString",
            "description": "Relative path to the launch file (e.g., src/pkg_name/launch/launch_name.launch)",
            "default": "src/pkg_name/launch/launch_name.launch"
        },
        {
            "id": "rosPackage",
            "type": "promptString",
            "description": "ROS package name",
            "default": "pkg_name"
        },
        {
            "id": "rosExecutable",
            "type": "promptString",
            "description": "ROS node executable name (e.g., my_node)",
            "default": ""
        },
        {
            "id": "pythonFile",
            "type": "promptString",
            "description": "Python file to debug (e.g., src/my_pkg/my_pkg/main.py)",
            "default": "${file}"
        }
    ],
    "configurations": [
        // =====================================================================
        // C++ Debugging (GDB) — Works with both ROS 1 and ROS 2
        // =====================================================================
        {
            "name": "🐛 C++: Launch Executable (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:executablePath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/.debug.env",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "set print thread-events off", "ignoreFailures": true },
                { "text": "set pagination off", "ignoreFailures": true }
            ],
            "sourceFileMap": {
                "${env:WORKSPACE_PATH}/src": "${workspaceFolder}/src"
            },
            "preLaunchTask": "⚙️ Source & Build (Debug, pre-launch)",
            "logging": { "engineLogging": false }
        },
        {
            "name": "🐛 C++: Launch (GDB, skip build)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:executablePath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/.debug.env",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "set print thread-events off", "ignoreFailures": true },
                { "text": "set pagination off", "ignoreFailures": true }
            ],
            "sourceFileMap": {
                "${env:WORKSPACE_PATH}/src": "${workspaceFolder}/src"
            },
            "preLaunchTask": "⚙️ Debugger env (pre-launch)",
            "logging": { "engineLogging": false }
        },
        {
            "name": "🐛 C++: Attach to Process (GDB)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${input:executablePath}",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "set print thread-events off", "ignoreFailures": true },
                { "text": "set pagination off", "ignoreFailures": true }
            ],
            "sourceFileMap": {
                "${env:WORKSPACE_PATH}/src": "${workspaceFolder}/src"
            },
            "logging": { "engineLogging": false }
        },

        // =====================================================================
        // Python Debugging (debugpy) — Works with both ROS 1 and ROS 2
        // =====================================================================
        {
            "name": "🐍 Python: Debug Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": [],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/.debug.env",
            "justMyCode": false,
            "preLaunchTask": "⚙️ Debugger env (pre-launch)"
        },
        {
            "name": "🐍 Python: Debug with Args",
            "type": "debugpy",
            "request": "launch",
            "program": "${input:pythonFile}",
            "args": [],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/.debug.env",
            "justMyCode": false,
            "preLaunchTask": "⚙️ Debugger env (pre-launch)"
        },
        {
            "name": "🐍 Python: Attach to debugpy (Remote)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "${env:WORKSPACE_PATH}"
                }
            ],
            "justMyCode": false
        },

        // =====================================================================
        // ROS 2 Launch Debugging (Humble and newer)
        // =====================================================================
        {
            "name": "🤖 ROS2: Launch File",
            "type": "debugpy",
            "request": "launch",
            "program": "/opt/ros/${env:ROS_DISTRO}/bin/ros2",
            "args": ["launch", "${input:launchFile}"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/.debug.env",
            "justMyCode": false,
            "preLaunchTask": "⚙️ Source & Build (Debug, pre-launch)"
        },
        {
            "name": "🤖 ROS2: Launch File (skip build)",
            "type": "debugpy",
            "request": "launch",
            "program": "/opt/ros/${env:ROS_DISTRO}/bin/ros2",
            "args": ["launch", "${input:launchFile}"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/.debug.env",
            "justMyCode": false,
            "preLaunchTask": "⚙️ Debugger env (pre-launch)"
        },
        {
            "name": "🤖 ROS2: Run Node",
            "type": "debugpy",
            "request": "launch",
            "program": "/opt/ros/${env:ROS_DISTRO}/bin/ros2",
            "args": ["run", "${input:rosPackage}", "${input:rosExecutable}"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/.debug.env",
            "justMyCode": false,
            "preLaunchTask": "⚙️ Debugger env (pre-launch)"
        },

        // =====================================================================
        // ROS 1 Launch Debugging (Noetic). roslaunch is a Python program;
        // rosrun is a bash script, so a Python node is debugged as the file
        // it is (ROS 1 remaps __name:= on the node's own argv).
        // =====================================================================
        {
            "name": "🐢 ROS1: roslaunch",
            "type": "debugpy",
            "request": "launch",
            "program": "/opt/ros/${env:ROS_DISTRO}/bin/roslaunch",
            "args": ["${input:rosPackage}", "${input:launchFile}"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/.debug.env",
            "justMyCode": false,
            "preLaunchTask": "⚙️ Source & Build (Debug, pre-launch)"
        },
        {
            "name": "🐢 ROS1: Python Node",
            "type": "debugpy",
            "request": "launch",
            "program": "${input:pythonFile}",
            "args": ["__name:=${input:rosExecutable}"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/.debug.env",
            "justMyCode": false,
            "preLaunchTask": "⚙️ Debugger env (pre-launch)"
        },

        // =====================================================================
        // C++ Node Direct Launch with GDB (ROS 1 & 2)
        // =====================================================================
        {
            "name": "🤖 ROS2: C++ Node (GDB Direct)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:executablePath}",
            "args": ["--ros-args", "-r", "__node:=${input:rosExecutable}"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/.debug.env",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "set print thread-events off", "ignoreFailures": true },
                { "text": "set pagination off", "ignoreFailures": true }
            ],
            "sourceFileMap": {
                "${env:WORKSPACE_PATH}/src": "${workspaceFolder}/src"
            },
            "preLaunchTask": "⚙️ Source & Build (Debug, pre-launch)",
            "logging": { "engineLogging": false }
        },
        {
            "name": "🐢 ROS1: C++ Node (GDB Direct)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:executablePath}",
            "args": ["__name:=${input:rosExecutable}"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/.debug.env",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "set print thread-events off", "ignoreFailures": true },
                { "text": "set pagination off", "ignoreFailures": true }
            ],
            "sourceFileMap": {
                "${env:WORKSPACE_PATH}/src": "${workspaceFolder}/src"
            },
            "preLaunchTask": "⚙️ Source & Build (Debug, pre-launch)",
            "logging": { "engineLogging": false }
        }
    ],

    // =========================================================================
    // Compound Launch Configurations
    // Launch multiple debug sessions simultaneously
    // =========================================================================
    "compounds": [
        {
            "name": "🚀 Full Debug: ROS2 Launch + C++ Attach",
            "configurations": [
                "🤖 ROS2: Launch File",
                "🐛 C++: Attach to Process (GDB)"
            ],
            "stopAll": true,
            "presentation": {
                "order": 1,
                "group": "compound"
            }
        },
        {
            "name": "🚀 Full Debug: ROS2 Launch + Python Attach",
            "configurations": [
                "🤖 ROS2: Launch File",
                "🐍 Python: Attach to debugpy (Remote)"
            ],
            "stopAll": true,
            "presentation": {
                "order": 2,
                "group": "compound"
            }
        },
        {
            "name": "🚀 Full Debug: ROS1 roslaunch + C++ Attach",
            "configurations": [
                "🐢 ROS1: roslaunch",
                "🐛 C++: Attach to Process (GDB)"
            ],
            "stopAll": true,
            "presentation": {
                "order": 3,
                "group": "compound"
            }
        },
        {
            "name": "🚀 Full Debug: ROS1 roslaunch + Python Attach",
            "configurations": [
                "🐢 ROS1: roslaunch",
                "🐍 Python: Attach to debugpy (Remote)"
            ],
            "stopAll": true,
            "presentation": {
                "order": 4,
                "group": "compound"
            }
        }
    ]
}
