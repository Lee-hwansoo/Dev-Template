{
  // =========================================================================
  // .vscode/tasks.json — build, test and utility tasks (ROS 1/2 and CMake).
  //
  // Every task runs in the shell VS Code is attached to, so run them from
  // inside the container; the build tasks source config/util_aliases.sh for
  // cbuild/mbuild/mtest/mlint. From the host use `make exec CMD='<command>'`.
  // =========================================================================
  "version": "2.0.0",
  "inputs": [
    {
      "id": "packageName",
      "type": "promptString",
      "description": "ROS package name to build (e.g., my_robot_pkg)"
    },
    {
      "id": "executablePath",
      "type": "promptString",
      "description": "Path to the executable to run (e.g., install/lib/my_pkg/my_node)"
    }
  ],
  "tasks": [
    // =====================================================================
    // ROS Workspace Build Tasks
    // =====================================================================
    {
      "label": "🔨 colcon: Build (Debug)",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && cbuild --debug'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Build all ROS packages with Debug symbols (required for GDB debugging)"
    },
    {
      "label": "🔨 colcon: Build (RelWithDebInfo)",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && cbuild'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Default development build — optimized with debug info"
    },
    {
      "label": "🔨 colcon: Build Package",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && cbuild --debug --pkg ${input:packageName}'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Build a single specific ROS package with Debug symbols"
    },
    {
      "label": "🔨 colcon: Build (Release)",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && cbuild --release'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Production-optimized build — maximum performance, no debug symbols"
    },
    // ── ROS Test Tasks ─────────────────────────────────────────────────
    {
      "label": "🧪 colcon: Test",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && cbt'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [],
      "detail": "Run all ROS package tests with console output"
    },
    {
      "label": "🧪 colcon: Test Results",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && cbtr --verbose'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [],
      "detail": "Display detailed test results summary"
    },

    // Pure C++ Build Tasks
    // =====================================================================
    {
      "label": "🔨 cmake: Build (Debug)",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && mbuild --debug'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Standard CMake Debug build for pure C++ projects"
    },
    {
      "label": "🔨 cmake: Build (Release)",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && mbuild --release'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Standard CMake Release build for pure C++ projects"
    },
    // =====================================================================
    // Python Tasks
    // =====================================================================
    {
      "label": "🐍 Python: uv sync",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && uvs'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Synchronize Python dependencies through the DevKit uvs alias logic"
    },
    {
      "label": "🐍 Python: Create venv",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && mkenv'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Create Python virtual environment through the DevKit mkenv alias logic"
    },
    // =====================================================================
    // Dependency Management
    // =====================================================================
    {
      "label": "🔄 Sync Repos (.repos only)",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/scripts/setup_sync_deps.sh\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Clone external repos listed in dependencies.repos (no rosdep)"
    },
    {
      "label": "🧪 Project: Test (mtest)",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && mtest'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [],
      "detail": "Run the project's tests — colcon test, ctest or pytest, chosen from the project layout"
    },
    {
      "label": "🎨 Project: Lint (mlint)",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && mlint'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Check ruff + clang-format rules without rewriting files (same rules as format-on-save)"
    },
    {
      "label": "🎨 Project: Lint --fix",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && mlint --fix'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Apply every fix ruff and clang-format can make automatically"
    },
    {
      "label": "🔍 Check Dependencies (Sanity)",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/scripts/check_deps.sh\" \"${workspaceFolder}/install\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Verify no missing shared libraries in install/ directory"
    },
    // =====================================================================
    // Workspace Utilities
    // =====================================================================
    {
      "label": "🚀 Full Hardware & GPU Check",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/scripts/check_hardware.sh\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Comprehensive diagnostic for GPU, CUDA, Display, and WSL2 configuration"
    },
    {
      "label": "📦 Sync Repos + rosdep (system deps)",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/scripts/setup_sync_deps.sh\" --rosdep",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Pull external repositories and install missing rosdep dependencies"
    },
    {
      "label": "⚡ GPU Status & Diagnostics",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/scripts/setup_gpu.sh\" status",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Quick check of the active rendering mode and GPU driver visibility"
    },
    {
      "label": "✅ DevKit: Verify (Script-only)",
      "type": "shell",
      "command": "bash -lc 'ws_scripts=\"$WS_SCRIPTS\"; [ -n \"$ws_scripts\" ] || ws_scripts=/workspace/scripts; bash \"$ws_scripts/verify_repo.sh\"'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Run DevKit repository validation without Docker socket access"
    },
    {
      "label": "📊 Build Cache Statistics (ccache)",
      "type": "shell",
      "command": "ccache -s",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Show ccache hit/miss statistics and cache size usage"
    },
    {
      "label": "🧹 Clean Workspace",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && mclean'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "⚠️ WARNING: Removes all build artifacts — use with caution"
    },
    // =====================================================================
    // Pre-Debug Helper Tasks
    // =====================================================================
    {
      "label": "⚙️ Source & Build (Debug, pre-launch)",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && cbuild --debug && (__smart_source || true)'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Auto-detect ROS version → build (Debug) → source workspace",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "⚡ Source & Build Package (Debug, pre-launch)",
      "type": "shell",
      "command": "bash -lc 'source \"$WORKSPACE_PATH/config/util_aliases.sh\" && cbuild --debug --pkg ${input:packageName} && (__smart_source || true)'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "⚡ Fast: Build ONLY the specified package before debugging (turnaround optimization)",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
